{
  "name":"@brix/backend",
  "private":true,
  "version":"1.0.0",
  "type":"module",
  "scripts":{
    "dev":"tsx src/server.ts",
    "build":"esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start":"node dist/server.mjs",
    "typecheck":"tsc --noEmit -p tsconfig.json",
    "lint":"tsc --noEmit -p tsconfig.json",
    "test":"vitest run",
    "test:watch":"vitest"
  },
  "dependencies":{
    "@supabase/supabase-js":"^2.116.0",
    "dotenv":"^17.2.3",
    "express":"^4.21.2",
    "pg":"^8.16.3",
    "pino":"^10.1.0",
    "pino-http":"^11.0.0",
    "socket.io":"^4.8.1",
    "ws":"^8.21.3"
  },
  "devDependencies":{
    "@types/express":"^4.17.21",
    "@types/node":"^22.14.0",
    "@types/pg":"^8.15.5",
    "esbuild":"^0.25.0",
    "tsx":"^4.21.0",
    "typescript":"~5.8.2",
    "vitest":"^3.2.4"
  }
}