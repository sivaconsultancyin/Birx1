{
  "compilerOptions":{
    "target":"ES2022",
    "module":"NodeNext",
    "moduleResolution":"NodeNext",
    "lib":["ES2022"],
    "strict":true,
    "noImplicitAny":true,
    "noUncheckedIndexedAccess":true,
    "skipLibCheck":true,
    "isolatedModules":true,
    "esModuleInterop":true,
    "allowImportingTsExtensions":true,
    "noEmit":true,
    "types":["node"]
  },
  "include":["src","tests"]
}